# Copia este fichero a .env. Todo se lee del entorno: la misma imagen se comporta igual
# la arranque el backend con `docker run`, Lambda o RunPod.

# --- Algoritmo ------------------------------------------------------------------
# Estrategia registrada (app/application/strategies.py): default | embeddings_only
STRATEGY=default
# Debe ser un modelo que el search-service también pueda cargar: embebe las consultas con
# el nombre que reportamos en el campo `model` del entrenamiento.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32
# Peso de cada variante de consulta generada por el LLM en el centroide (documento = 1.0).
QUERY_VARIANT_WEIGHT=0.35

# --- Enriquecimiento (el paso LLM) ----------------------------------------------
# local  -> llama.cpp + el GGUF horneado en la imagen (sin clave de API, nada sale de la máquina)
# groq   -> API de Groq (rápida, requiere GROQ_API_KEY) — la opción que hace viable AWS Lambda
# gemini -> API de Gemini (requiere GEMINI_API_KEY)
# none   -> sin LLM: los elementos se embeben con su texto + descripción
ENRICHER=local
# Tope de elementos enriquecidos por ejecución (0 = sin tope). Lo omitido conserva su texto
# y lo recoge el siguiente entrenamiento. Útil para no salirse de un timeout (Lambda: 900 s).
ENRICH_MAX_ELEMENTS=0

LLM_MODEL_PATH=/app/models/Qwen2.5-3B-Instruct-Q4_K_M.gguf
LLM_CONTEXT_SIZE=2048
LLM_MAX_TOKENS=384
LLM_TEMPERATURE=0.3
# LLM_THREADS: 0 = decide llama.cpp.
# LLM_GPU_LAYERS: -1 = descargar todas las capas a la GPU. Seguro por defecto (un build de
# llama.cpp sin CUDA lo ignora); la GPU solo se usa de verdad con la imagen CUDA
# (Dockerfile.gpu) y el contenedor arrancado con `--gpus`.
LLM_THREADS=0
LLM_GPU_LAYERS=-1

# Claves de las APIs remotas (secretos: rellenar solo si ENRICHER=groq|gemini).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Timeout (segundos) de las llamadas a Groq/Gemini.
LLM_API_TIMEOUT_SECONDS=60

# --- Callback al backend --------------------------------------------------------
# Solo como respaldo: el launcher envía el secreto dentro del job. Debe coincidir con el
# TRAINING_WEBHOOK_SECRET del backend.
WEBHOOK_SECRET=dev-webhook-secret
CALLBACK_TIMEOUT_SECONDS=60
CALLBACK_RETRIES=3

# --- Coste / varios -------------------------------------------------------------
# Se reporta como coste del entrenamiento ($/h de la máquina; 0 en local).
COMPUTE_PRICE_PER_HOUR=0
LOG_LEVEL=INFO

# --- Entrada del job (solo entrypoint CLI, por ejecución) ------------------------
# Variables de entorno reales del proceso (`docker run -e`), no las lee el .env.
# TRAINING_JOB: el JSON del job en línea. TRAINING_DATA_PATH: ruta a un fichero JSON.
#TRAINING_JOB=
#TRAINING_DATA_PATH=/data/input/job.json

# --- Build (docker compose) ------------------------------------------------------
# false = imagen ligera sin el GGUF local (para Groq/Gemini o sin enriquecimiento).
INCLUDE_LLM=true
