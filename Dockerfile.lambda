# Imagen para AWS Lambda (función de contenedor), sobre la imagen base de AWS, que ya trae
# el Runtime Interface Client y el emulador para pruebas locales.
#
# Sin LLM local a propósito: Lambda no tiene GPU y corta a los 900 s — un GGUF reventaría el
# timeout con ~100-200 elementos. Despliega con ENRICHER=groq|gemini|none (el job tarda
# segundos y la imagen ronda 1,5 GB); para ENRICHER=local usa RunPod (GPU) o AWS Batch con
# los otros Dockerfiles, que ejecutan el mismo código.
FROM public.ecr.aws/lambda/python:3.11

ENV HF_HOME=/opt/hf-cache \
    ENRICHER=groq

RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.5.1

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

ARG EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
ENV EMBEDDING_MODEL=${EMBEDDING_MODEL}
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('${EMBEDDING_MODEL}')"

COPY app ${LAMBDA_TASK_ROOT}/app

CMD ["app.entrypoints.lambda_handler.handler"]
