# Imagen GPU: RunPod Serverless (CMD por defecto) y AWS Batch en EC2 con GPU (sobrescribiendo
# el CMD con `python -m app.entrypoints.cli`). Es la imagen para ENRICHER=local: la GPU baja
# el paso LLM de ~7 s/elemento a bastante menos de un segundo.

# --- build stage: compila llama-cpp-python con CUDA -----------------------------------
# El wheel precompilado cu121 de abetlen no trae kernels (ni PTX) para GPUs más nuevas
# que las de su build de 2023/24: en esas GPUs llama.cpp cae a CPU EN SILENCIO y el paso
# LLM pasa de <1 s/elemento a ~8 s/elemento (visto en prod: 2051 s para 250 elementos).
# Compilar aquí con nvcc 12.8 garantiza kernels para cualquier GPU que asigne RunPod.
#
# Arquitecturas: 80-real cubre Ampere y Ada (sm_86/sm_89 ejecutan cubins sm_80, mismo
# major), 90-real Hopper, 100-real B200, y 120 (real+PTX) Blackwell consumer y futuras.
# No usar `all-major`: añade sm_60/70 (GPUs que RunPod no ofrece) y el build de RunPod
# ya roza su límite de 30 min.
FROM nvidia/cuda:12.8.1-devel-ubuntu22.04 AS llama-build

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3-pip git build-essential cmake \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip \
    && CMAKE_ARGS="-DGGML_CUDA=on -DCMAKE_CUDA_ARCHITECTURES=80-real;90-real;100-real;120" \
       CMAKE_BUILD_PARALLEL_LEVEL=$(nproc) \
       python -m pip wheel --no-cache-dir --no-deps --wheel-dir /wheels \
           "llama-cpp-python==0.3.34"

# --- runtime --------------------------------------------------------------------------
FROM nvidia/cuda:12.8.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/.hf-cache

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3-pip git curl \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && ln -sf /usr/bin/python3.11 /usr/bin/python3 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip

RUN pip install torch --index-url https://download.pytorch.org/whl/cu121

# Wheel compilado en el build stage (ver arriba): las dependencias las resuelve pip de PyPI.
COPY --from=llama-build /wheels /wheels
RUN pip install /wheels/llama_cpp_python-*.whl && rm -rf /wheels

COPY requirements.txt ./
RUN pip install -r requirements.txt "runpod>=1.7,<2.0"

ARG EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
ENV EMBEDDING_MODEL=${EMBEDDING_MODEL}
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('${EMBEDDING_MODEL}')"

ARG LLM_MODEL_REPO=bartowski/Qwen2.5-3B-Instruct-GGUF
ARG LLM_MODEL_FILE=Qwen2.5-3B-Instruct-Q4_K_M.gguf
ENV LLM_MODEL_PATH=/app/models/${LLM_MODEL_FILE}
RUN mkdir -p /app/models \
    && python -c "from huggingface_hub import hf_hub_download; hf_hub_download(repo_id='${LLM_MODEL_REPO}', filename='${LLM_MODEL_FILE}', local_dir='/app/models')"

# Modelos de embeddings extra seleccionables por entrenamiento (opción `embedding_model`).
# Mantener en sincronía con el Dockerfile de CPU, `xeye.training.embedding-models` del
# backend y la imagen del search-service.
# Default vacío: en prod solo se ofrece MiniLM (RAM del VPS) y RunPod construye esta
# imagen desde GitHub sin posibilidad de pasar build-args — el default ES la config de prod.
# Además mpnet (~1.1 GB) acercaba el build al límite de 30 min de RunPod.
ARG EXTRA_EMBEDDING_MODELS=""
RUN for m in ${EXTRA_EMBEDDING_MODELS}; do \
        python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('$m')"; \
    done

COPY app ./app

CMD ["python", "-m", "app.entrypoints.runpod_handler"]
